{
	"name": "ironsworn",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "npm run copy-data && npm run build-content-index && vite dev",
		"build": "npm run copy-data && npm run build-content-index && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && vitest run",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"copy-data": "node scripts/copy-data.js",
		"build-content-index": "npx tsx scripts/build-content-index.ts",
		"fetch-source": "npx tsx scripts/fetch-source.ts",
		"extract": "npx tsx scripts/extract-strings.ts",
		"build-i18n": "npx tsx scripts/build-i18n.ts",
		"extract-pdf": "npx tsx scripts/extract-pdf.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tsx": "^4.22.3",
		"typescript": "^6.0.2",
		"vite": "^8.0.7",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^4.1.8",
		"workbox-window": "^7.4.1"
	}
}
